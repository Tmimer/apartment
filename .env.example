# Supabase PostgreSQL connection string (or local SQLite fallback)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# Shared Apartment Passcode (unlocks the hub for Tamir & Mikush)
APP_PASSCODE=apartment123

# Session Encryption Key
SECRET_KEY=generate-a-secure-random-secret-key-here

# Gemini Multimodal & Structured Output API Key (default: gemini-3.8-flash)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash
